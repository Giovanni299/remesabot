PORT=8092

# URL de la Platform API (corre en Docker en el puerto 8085)
PLATFORM_API_BASE_URL=http://localhost:8085

# URL pública del Anchor Platform (SEP-24 client-facing API)
ANCHOR_SEP24_URL=http://localhost:8080

# URL pública del business-server (ej. túnel de Cloudflare para desarrollo local)
SEP24_PUBLIC_URL=https://your-tunnel.trycloudflare.com

# Debe coincidir con SECRET_SEP10_JWT_SECRET en la config del Anchor Platform
SECRET_SEP10_JWT_SECRET=your_sep10_jwt_secret_here

# Cuenta Stellar de prueba para el bot (generar con Friendbot + trustline USDC)
STELLAR_TEST_ACCOUNT=G...

# Cuenta de distribución — firma los pagos USDC on-chain
DISTRIBUTION_SECRET_KEY=S...

# Telegram — obtener el token de @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Solo en producción: URL pública del servidor para registrar el webhook
# Si no se define, el bot usa long polling (recomendado para desarrollo local)
# TELEGRAM_WEBHOOK_URL=https://tu-dominio.com
